{
  "homepage": "https://VoltG3.github.io/dashmetry_menu/",
  "name": "dashmetry_menu",
  "version": "0.1.0",
  "private": true,
  "main": "public/electron.js",
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^13.2.1",
    "asset-revision-webpack-plugin": "^1.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.10.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.1",
    "react-scripts": "5.0.1",
    "styled-components": "^6.4.2",
    "web-vitals": "^5.2.0",
    "webpack": "^5.107.1"
  },
  "scripts": {
    "start": "REACT_APP_VERSION=$(git describe --tags --abbrev=0 2>/dev/null || echo 'dev') react-scripts start",
    "build": "REACT_APP_VERSION=$(git describe --tags --abbrev=0 2>/dev/null || echo 'dev') react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "yarn build",
    "deploy": "gh-pages -d build",
    "electron:start": "electron .",
    "electron:dev": "concurrently \"yarn start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "yarn build && electron-builder"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.dashmetry.menu",
    "productName": "Dashmetry Menu",
    "files": ["build/**/*", "public/electron.js"],
    "win": { "target": "portable" },
    "linux": { "target": "AppImage" },
    "mac": { "target": "dmg" }
  }
}
